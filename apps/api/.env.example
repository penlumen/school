PORT=5445
JWT_SECRET="change_me_to_a_long_random_secret"
# Encrypts Paystack/SMTP/integration secrets saved in School Settings. Set once; changing it makes saved secrets unreadable.
SETTINGS_ENCRYPTION_KEY=

# Web app address, for links in emails (invites, password resets).
WEB_APP_URL="http://localhost:3000"
# Public address of this API: the OpenID Connect issuer for connected apps (docs/integrations.md).
API_PUBLIC_URL="http://localhost:5445"

# Platform SMTP, used for schools that have not set up their own in School Settings > Email.
# Leave SMTP_HOST empty to send no email for those schools.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Penlumen <no-reply@example.com>"

REDIS_URL="redis://localhost:6379"
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/school"

AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_PUBLIC_URL=""
AWS_S3_ENDPOINT=""
AWS_S3_BUCKET=""

FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""