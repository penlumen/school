// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// PRISMA SCHEMA FILE

generator client {
  provider = "prisma-client-js"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ROOT
  ADMIN
  STAFF
  PARENT
}

// ========== USER ==========
model User {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  school_uuid String?
  name        String?
  email       String
  password    String
  contact     String?
  alt_contact String?
  avatar      String?
  address     String?
  role        Role     @default(ADMIN)
  position    String   @default("guardian")
  status      String   @default("active")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  school School? @relation(fields: [school_uuid], references: [uuid])

  students Student[]
  access   BranchAccess[]
  control  AccessControl[]

  @@unique([school_uuid, email, role])
}

model AccessControl {
  id          Int    @id @default(autoincrement())
  user_uuid   String
  branch_uuid String
  access      String

  user   User?   @relation(fields: [user_uuid], references: [uuid])
  branch Branch? @relation(fields: [branch_uuid], references: [uuid])

  @@unique([user_uuid, branch_uuid, access])
}

// ========== SCHOOL ==========
model School {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  token      String   @unique @default(uuid())
  email      String   @unique
  slug       String   @unique
  name       String
  contact    String?
  avatar     String?
  address    String?
  city       String?
  state      String?
  country    String?
  zip        String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users    User[]
  branches Branch[]
  access   BranchAccess[]
}

// ========== BRANCH ==========
model Branch {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  school_uuid String
  name        String
  email       String?
  contact     String?
  avatar      String?
  address     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  grades   Grade[]
  classes  Class[]
  students Student[]
  control  AccessControl[]
  access   BranchAccess[]
  school   School          @relation(fields: [school_uuid], references: [uuid])
}

model BranchAccess {
  id          Int    @id @default(autoincrement())
  role        Role
  user_uuid   String
  school_uuid String
  branch_uuid String

  user   User?   @relation(fields: [user_uuid], references: [uuid])
  school School? @relation(fields: [school_uuid], references: [uuid])
  branch Branch? @relation(fields: [branch_uuid], references: [uuid])

  @@unique([user_uuid, branch_uuid, role])
}

// ========== STUDENT ==========
model Student {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  parent_uuid String
  branch_uuid String
  class_uuid  String
  reg_number  String
  name        String
  avatar      String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent  User     @relation(fields: [parent_uuid], references: [uuid])
  branch  Branch   @relation(fields: [branch_uuid], references: [uuid])
  class   Class    @relation(fields: [class_uuid], references: [uuid])
  results Result[]

  @@unique([branch_uuid, reg_number])
}

// ========== CLASS ==========
model Class {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  branch_uuid String
  name        String
  status      String   @default("active")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  branch   Branch?   @relation(fields: [branch_uuid], references: [uuid])
  subjects Subject[]
  students Student[]
}

// ========== SUBJECT ==========
model Subject {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  class_uuid String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  class Class? @relation(fields: [class_uuid], references: [uuid])
}

// ========== GRADE ==========
model Grade {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  branch_uuid String
  score       Float
  grade       String
  remark      String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  branch Branch? @relation(fields: [branch_uuid], references: [uuid])
}

// ========== RESULT ==========
model Result {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  student_uuid String
  class_name   String
  grade        String
  remark       String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  student     Student?      @relation(fields: [student_uuid], references: [uuid])
  assessments Assessments[]
}

// ========== ASSESSMENTS ==========
model Assessments {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  result_uuid String
  subject     String
  assignment  Float
  assesment   Float
  examination Float
  overall     Float
  grade       String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  result Result? @relation(fields: [result_uuid], references: [uuid])

  @@unique([result_uuid, subject])
}
