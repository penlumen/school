// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// PRISMA SCHEMA FILE

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ROOT
  ADMIN
  STAFF
  PARENT
}

enum Position {
  ADMINISTRATIVE
  ACADEMIC
  GUARDIAN
  PARENT
}

enum ResultStatus {
  APPROVED
  PENDING
  REJECTED
}

// ========== USER ==========
model User {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  school_uuid String?
  name        String?
  email       String
  password    String
  contact     String?
  alt_contact String?
  avatar      String?
  address     String?
  role        Role     @default(ADMIN)
  position    Position @default(GUARDIAN)
  status      String   @default("active")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  school School? @relation(fields: [school_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)

  heading  Class[]
  students Student[]
  access   BranchAccess[]
  control  AccessControl[]

  @@unique([school_uuid, email, role])
}

model AccessControl {
  id          Int      @id @default(autoincrement())
  user_uuid   String
  branch_uuid String
  access      String
  read        Boolean  @default(false)
  write       Boolean  @default(false)
  delete      Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user   User?   @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
  branch Branch? @relation(fields: [branch_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)

  @@unique([user_uuid, branch_uuid, access])
}

// ========== SCHOOL ==========
model School {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  token      String   @unique @default(uuid())
  email      String   @unique
  slug       String   @unique
  name       String
  contact    String?
  avatar     String?
  address    String?
  city       String?
  state      String?
  country    String?
  zip        String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  users    User[]
  branches Branch[]
  access   BranchAccess[]
}

// ========== BRANCH ==========
model Branch {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  school_uuid String
  name        String
  email       String?
  contact     String?
  avatar      String?
  address     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  grades   Grade[]
  classes  Class[]
  students Student[]
  control  AccessControl[]
  access   BranchAccess[]
  calendar Calendar[]
  school   School          @relation(fields: [school_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
}

model BranchAccess {
  id          Int      @id @default(autoincrement())
  role        Role
  user_uuid   String
  school_uuid String
  branch_uuid String
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  user   User?   @relation(fields: [user_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
  school School? @relation(fields: [school_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
  branch Branch? @relation(fields: [branch_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)

  @@unique([user_uuid, branch_uuid, role])
}

model Calendar {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  branch_uuid String
  session     String
  term        String?
  open_date   DateTime
  close_date  DateTime
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  results Result[]
  branch  Branch   @relation(fields: [branch_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
}

// ========== STUDENT ==========
model Student {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  parent_uuid String
  branch_uuid String
  class_uuid  String
  reg_number  String
  name        String
  avatar      String?
  status      String   @default("active")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent  User     @relation(fields: [parent_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
  branch  Branch   @relation(fields: [branch_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
  class   Class    @relation(fields: [class_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
  results Result[]

  @@unique([branch_uuid, reg_number])
}

// ========== CLASS ==========
model Class {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  branch_uuid  String
  teacher_uuid String?
  name         String
  capacity     Int?     @default(0)
  status       String   @default("active")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  branch   Branch?   @relation(fields: [branch_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
  teacher  User?     @relation(fields: [teacher_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
  subjects Subject[]
  students Student[]
}

// ========== SUBJECT ==========
model Subject {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  class_uuid String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  class Class? @relation(fields: [class_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)

  @@unique([class_uuid, name])
}

// ========== GRADE SETTING ==========
model Grade {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  branch_uuid String
  score       Float
  grade       String
  remark      String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  branch Branch? @relation(fields: [branch_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
}

// ========== RESULT ==========
model Result {
  id               Int          @id @default(autoincrement())
  uuid             String       @unique @default(uuid())
  student_uuid     String
  calendar_uuid    String
  class_uuid       String
  class_name       String
  overall          Float        @default(0)
  status           ResultStatus @default(PENDING)
  teacher_remark   String?
  principal_remark String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  assessments Assessments[]

  calendar Calendar? @relation(fields: [calendar_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)
  student  Student?  @relation(fields: [student_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)

  @@unique([calendar_uuid, class_name, student_uuid])
}

// ========== ASSESSMENTS ==========
model Assessments {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  result_uuid String
  subject     String
  assignment  Float    @default(0)
  assessment  Float    @default(0)
  examination Float    @default(0)
  overall     Float    @default(0)
  grade       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  result Result? @relation(fields: [result_uuid], references: [uuid], onDelete: Cascade, onUpdate: Cascade)

  @@unique([result_uuid, subject])
}
