# Shared/root env reference. Each app also reads its own .env at runtime
# (apps/api/.env.example and apps/web/.env.example have the same values,
# split by which app actually needs them).

# --- apps/api ---
PORT=5445
JWT_SECRET="change_me_to_a_long_random_secret"
REDIS_URL="redis://localhost:6379"
DATABASE_URL="postgresql://postgres:password@localhost:5432/school?schema=public"
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_PUBLIC_URL=""
AWS_S3_ENDPOINT=""

# --- apps/web ---
NEXT_PUBLIC_API_URL="http://localhost:5445"
NEXT_PUBLIC_SCHOOL_TOKEN=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
NEXT_PUBLIC_APP_LOGO=""
NEXT_PUBLIC_APP_FULL_NAME=""
NEXT_PUBLIC_APP_SLUG_NAME=""
NEXT_PUBLIC_APP_PHONE=""
NEXT_PUBLIC_APP_EMAIL=""
NEXT_PUBLIC_APP_ADDRESS=""
